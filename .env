# === Day 6 - Data Intelligence Stack ===
NODE_ENV=production
PORT=8080

# Host-published ports (docker-compose)
DAY6_API_PORT=4408
DAY6_PROMETHEUS_PORT=9408
DAY6_GRAFANA_PORT=3408

# PostgreSQL (dedicated container for this stack, same convention as Day 3/4/5)
POSTGRES_HOST=192.168.0.140
POSTGRES_PORT=8063

POSTGRES_USER=opentts
POSTGRES_PASSWORD=e89ef1bcc9313fea7f9ae788ec38e9285787d3dddd98d21b165cdd1f7c6d8d64
POSTGRES_DB=ai_gateway_routing
DATABASE_URL=postgres://opentts:e89ef1bcc9313fea7f9ae788ec38e9285787d3dddd98d21b165cdd1f7c6d8d64@192.168.0.140:8063/ai_gateway_routing


# Redis (dedicated container for this stack, same convention as Day 3/4/5)
REDIS_HOST=db_redis-public
REDIS_PORT=6379

# Existing platform endpoints to REUSE (do not reimplement)
# These match what the Day 4/5 dependency checks discovered in your logs.
# Override to whatever your docker network / host actually resolves to.
STACK3_URL=http://192.168.0.140:4405
STACK4_URL=http://192.168.0.140:4406
STACK5_URL=http://192.168.0.140:4407

# AI recovery (Level 5) - which existing execution path to call.
# "stack3" calls Stack 3 POST /v1/execute directly (no orchestration).
# "stack5" calls Stack 5 POST /v1/chat (goes through classification/orchestration).
AI_RECOVERY_ROUTE=stack3
AI_RECOVERY_PROVIDER=groq
AI_RECOVERY_MODEL=openai/gpt-oss-120b
AI_RECOVERY_TIMEOUT_MS=15000

# Recovery / chunking defaults
DEFAULT_MAX_PAYLOAD_SIZE=10000
ALLOW_AI_RECOVERY_DEFAULT=true
ALLOW_CHUNKING_DEFAULT=true

# Queue names (BullMQ, same Redis instance)
QUEUE_STRUCTURE=data-structure
QUEUE_RECOVERY=json-recovery
QUEUE_CHUNKING=data-chunking
